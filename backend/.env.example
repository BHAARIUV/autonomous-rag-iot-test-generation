# ============================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to Git.
# ============================================================

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM provider (used starting Phase 7) ---
# Set to "mock" to run without any real API calls (safe default for now).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Embeddings (Phase 6 RAG) ---
# "local" is the deterministic, offline-safe hashing embedder (no API key,
# no network, no model download). Set to "openai" to use the OpenAI text
# embedding API; then EMBEDDING_API_KEY must be set.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=256
EMBEDDING_API_KEY=

# --- RAG knowledge base (Phase 6) ---
RAG_KNOWLEDGE_DIR=knowledge_base/documents
RAG_CHROMA_DIR=knowledge_base/chroma
RAG_COLLECTION_NAME=iot_knowledge
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4

# --- Execution engine (Phase 8) ---
EXECUTION_MAX_DURATION_SECONDS=10.0
EXECUTION_MAX_WAIT_SECONDS=5.0

# --- MQTT (used starting Phase 3) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=iot_test_framework
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=5.0
MQTT_RECONNECT_DELAY_SECONDS=1.0
MQTT_MAX_RECONNECT_ATTEMPTS=5
MQTT_QOS=1

# --- MQTT topics ---
MQTT_TOPIC_TEMPERATURE=iot/sensor/temperature
MQTT_TOPIC_STATUS=iot/sensor/status
MQTT_TOPIC_FAULT=iot/test/fault

# --- Database ---
DATABASE_URL=sqlite:///./data/framework.db

# --- Refinement loop defaults ---
MAX_REFINEMENT_ITERATIONS=3
TARGET_REQUIREMENT_COVERAGE=90
TARGET_FAULT_DETECTION=90

# --- Dashboard API / CORS (Phase 12/15) ---
# Comma-separated browser origins allowed to call the read-only JSON API
# served by `python -m app.dashboard` (the Phase 15 React frontend).
DASHBOARD_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
